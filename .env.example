# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
TRIAGE_MODEL=qwen2.5:7b-instruct-q4_K_M
# Perfil CPU / poca VRAM: qwen2.5:3b-instruct-q4_K_M
TRIAGE_JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M

# LangSmith (opcional; solo dataset sintetico, nunca sintomas reales)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reto3-triaje

# Costo energetico (informativo)
COSTO_HORA_EQUIPO_COP=175
